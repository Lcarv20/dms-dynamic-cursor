import QtQuick
import Quickshell
import Quickshell.Io
import qs.Common
import qs.Services
import qs.Modules.Plugins

QtObject {
    id: root

    // Injected by DMS PluginService
    property string pluginId: ""
    property var pluginService: null

    readonly property var log: Log.scoped("DynamicCursor")

    // Resolved path to the self-contained Go helper binary
    readonly property string helperBin: {
        const u = Qt.resolvedUrl("bin/cursor-recolor").toString();
        return u.startsWith("file://") ? u.substring(7) : u;
    }

    // ------------------------------------------------------------- Settings
    property bool enabled: true
    property bool invertSets: false

    readonly property string fallbackTheme: {
        const cs = SettingsData.cursorSettings;
        const theme = cs && cs.theme ? cs.theme : "System Default";
        if (theme !== "System Default" && !theme.startsWith("Dux-Dynamic-")) {
            return theme;
        }
        return "Adwaita";
    }

    function reloadSettings() {
        if (!pluginService || !pluginId) return;
        const prevEnabled = enabled;
        const prevInvert = invertSets;
        enabled = pluginService.loadPluginData(pluginId, "enabled", true);
        invertSets = pluginService.loadPluginData(pluginId, "invertSets", false);

        if (prevEnabled !== enabled) {
            if (!enabled) {
                applyTimer.stop();
                statusMessage = "disabled in plugin settings";
                restoreDefaultCursor();
            } else {
                lastAccent = "";
                scheduleApply();
            }
        } else if (prevInvert !== invertSets && enabled) {
            lastAccent = "";
            scheduleApply();
        }
    }

    onPluginServiceChanged: reloadSettings()
    onPluginIdChanged: reloadSettings()

    property Connections pluginConnections: Connections {
        target: root.pluginService
        function onPluginDataChanged(changedId) {
            if (changedId === root.pluginId) {
                root.reloadSettings();
            }
        }
    }

    function restoreDefaultCursor() {
        const targetTheme = fallbackTheme;
        const cs = SettingsData.cursorSettings;
        const targetSize = (cs && cs.size > 0) ? cs.size : 32;

        const script = 'printf "[Icon Theme]\\nName=Default\\nComment=Default Cursor Theme\\nInherits=' + targetTheme + '\\n" > "$HOME/.icons/default/index.theme"; ' +
            'gsettings set org.gnome.desktop.interface cursor-theme "' + targetTheme + '" 2>/dev/null || true; ' +
            'gsettings set org.gnome.desktop.interface cursor-size "' + targetSize + '" 2>/dev/null || true; ' +
            'sed -i -E "s/^(gtk-cursor-theme-name=).*/\\1' + targetTheme + '/" "$HOME/.config/gtk-3.0/settings.ini" "$HOME/.config/gtk-4.0/settings.ini" 2>/dev/null || true; ' +
            'sed -i -E "s/^(gtk-cursor-theme-size=).*/\\1' + targetSize + '/" "$HOME/.config/gtk-3.0/settings.ini" "$HOME/.config/gtk-4.0/settings.ini" 2>/dev/null || true; ' +
            'sed -i -E "s/^(Xcursor\\.theme:).*/\\1 ' + targetTheme + '/" "$HOME/.Xresources" 2>/dev/null || true; ' +
            'sed -i -E "s/^(Xcursor\\.size:).*/\\1 ' + targetSize + '/" "$HOME/.Xresources" 2>/dev/null || true; ' +
            'xrdb -merge "$HOME/.Xresources" 2>/dev/null || true; ' +
            'printf \'// ! DO NOT EDIT !\\n// ! AUTO-GENERATED BY DMS !\\n// ! CHANGES WILL BE OVERWRITTEN !\\n// ! PLACE YOUR CUSTOM CONFIGURATION ELSEWHERE !\\n\\ncursor {\\n    xcursor-theme "' + targetTheme + '"\\n    xcursor-size ' + targetSize + '\\n}\\n\' > "$HOME/.config/niri/dms/cursor.kdl"; ' +
            'niri msg action load-config-file 2>/dev/null || true';
        Quickshell.execDetached(["sh", "-c", script]);
    }

    readonly property bool cursorIsDefault: {
        const cs = SettingsData.cursorSettings;
        const theme = cs && cs.theme ? cs.theme : "System Default";
        // Also match our own dynamic themes if previously set
        return theme === "System Default" || theme.startsWith("Dux-Dynamic-");
    }

    // ---------------------------------------------------------------- State
    property string statusMessage: "initializing"
    property string lastAppliedTheme: ""
    property string lastAppliedSlot: ""
    property int lastElapsedMs: 0
    property string lastAccent: ""

    readonly property string currentMode: SessionData.isLightMode ? "light" : "dark";

    function colorToHex(c) {
        if (!c) return "#ffffff";
        const r = Math.round(c.r * 255).toString(16).padStart(2, "0");
        const g = Math.round(c.g * 255).toString(16).padStart(2, "0");
        const b = Math.round(c.b * 255).toString(16).padStart(2, "0");
        return "#" + r + g + b;
    }

    readonly property string currentFillHex: {
        if (invertSets) {
            return SessionData.isLightMode ? "#202124" : "#f5f5f5";
        }
        return SessionData.isLightMode ? "#ffffff" : "#202124";
    }

    readonly property string currentOutlineHex: colorToHex(Theme.primary)

    // Debounce timer for smooth slider and wallpaper transitions
    property Timer applyTimer: Timer {
        interval: 150
        onTriggered: root.executeRecolor()
    }

    Component.onCompleted: {
        log.info("Dynamic Cursor daemon loaded. Helper: " + helperBin);
        reloadSettings();
        SettingsData.cursorSettingsChanged.connect(onCursorConfigChanged);
        Theme.primaryChanged.connect(scheduleApply);
        SessionData.isLightModeChanged.connect(scheduleApply);
        Qt.callLater(startup);
    }

    Component.onDestruction: {
        applyTimer.stop();
        const stillEnabled = pluginService
            ? pluginService.loadPluginData(pluginId, "enabled", true)
            : false;
        if (!stillEnabled) {
            restoreDefaultCursor();
        }
    }

    function startup() {
        if (cursorIsDefault && enabled) {
            scheduleApply();
        } else {
            statusMessage = enabled ? "standby: manual cursor theme selected" : "disabled in plugin settings";
        }
    }

    function onCursorConfigChanged() {
        if (cursorIsDefault && enabled) {
            scheduleApply();
        } else {
            applyTimer.stop();
            statusMessage = "standby: manual cursor theme";
        }
    }

    function scheduleApply() {
        if (!cursorIsDefault || !enabled) {
            return;
        }
        applyTimer.restart();
    }

    // Process executor
    property Process recolorProc: Process {
        id: proc
        stdout: SplitParser {
            onRead: data => {
                if (!data) return;
                try {
                    const res = JSON.parse(data.trim());
                    if (res.status === "ok") {
                        root.lastAppliedTheme = res.theme || "";
                        root.lastAppliedSlot = res.slot || "";
                        root.lastElapsedMs = res.elapsed_ms || 0;
                        root.statusMessage = "active: " + res.theme + " (" + res.elapsed_ms + " ms)";
                        root.log.info("Recolored & applied " + res.theme + " in " + res.elapsed_ms + " ms");
                    } else if (res.status === "error") {
                        root.statusMessage = "error: " + (res.error || "unknown");
                        root.log.error("Recolor error: " + res.error);
                    }
                } catch (e) {
                    root.log.warning("Parsing recolor output: " + data);
                }
            }
        }
        stderr: SplitParser {
            onRead: err => {
                if (err && err.trim().length > 0) {
                    root.log.error("recolor process stderr: " + err.trim());
                }
            }
        }
    }

    function executeRecolor() {
        if (proc.running) {
            // If already running, reschedule briefly
            applyTimer.restart();
            return;
        }

        const fill = currentFillHex;
        const outline = currentOutlineHex;

        if (fill === "" || outline === "") return;
        if (outline === lastAccent && lastAppliedTheme !== "") {
            // Color hasn't changed
            return;
        }

        lastAccent = outline;
        statusMessage = "recoloring cursor...";

        proc.command = [
            helperBin,
            "--fill=" + fill,
            "--outline=" + outline,
            "--slot=auto",
            "--apply=true"
        ];
        proc.running = true;
    }
}
